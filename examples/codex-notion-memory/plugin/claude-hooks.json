{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOTION_MEMORY_AGENT=claude node \"${CLAUDE_PLUGIN_ROOT}/hook.cjs\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "NOTION_MEMORY_AGENT=claude node \"${CLAUDE_PLUGIN_ROOT}/hook.cjs\" post-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NOTION_MEMORY_AGENT=claude node \"${CLAUDE_PLUGIN_ROOT}/hook.cjs\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
