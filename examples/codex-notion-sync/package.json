    "sync-memories": "node plugin/src/main.ts sync-memories",
    "status": "node plugin/src/main.ts status"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
