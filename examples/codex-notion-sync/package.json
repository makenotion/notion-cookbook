{
  "name": "@notion-cookbook/codex-notion-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Codex plugin that syncs Codex session transcripts and Codex memories into Notion.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit",
