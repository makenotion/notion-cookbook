# Notion integration token. Alternatively put {"token": "..."} in ~/.codex/notion-sync.json.
NOTION_API_TOKEN=ntn_your_token_here
# Page shared with the integration. The plugin creates "Codex Sessions" under it.
NOTION_SYNC_PARENT_PAGE_ID=00000000000000000000000000000000
# Optional. Only change this when testing against a non-production Notion API.
NOTION_API_BASE_URL=https://api.notion.com
# Optional and experimental. Set to 1 to import Codex memories into Notion Memories.
NOTION_SYNC_MEMORIES=0
