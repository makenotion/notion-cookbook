{
  "name": "notion-cookbook",
  "version": "1.0.0",
  "description": "A collection of guides, examples, and resources for building with Notion's developer platform",
  "private": true,
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10.9.9"
  },
  "scripts": {
    "projects:install": "node scripts/run-projects.mjs install",
    "projects:typecheck": "node scripts/run-projects.mjs typecheck",
    "projects:test": "node scripts/run-projects.mjs test",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "agents:sync": "node scripts/sync-agent-files.mjs",
    "agents:check": "node scripts/sync-agent-files.mjs --dryRun",
    "agents:test": "node --test scripts/*.test.mjs",
    "plugins:build": "node scripts/build-plugins.mjs",
    "plugins:check": "node scripts/build-plugins.mjs --dryRun",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore node_modules --ignore \"**/node_modules/**\" --config .markdownlint.jsonc",
    "format": "prettier --write \"**/*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml}\"",
    "verify": "npm run catalog:validate && npm run agents:check && npm run agents:test && npm run plugins:check && npm run projects:typecheck && npm run projects:test && npm run lint:markdown && npm run format:check",
    "verify:all": "npm run projects:install && npm run verify",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{json,yml,yaml}": [
      "prettier --write"
    ],
    "!(*AGENTS|*CLAUDE).md": [
      "prettier --write",
      "markdownlint --config .markdownlint.jsonc --fix"
    ],
    "*.{ts,js}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/makenotion/notion-cookbook.git"
  },
  "keywords": [
    "notion",
    "notion-api",
    "examples",
    "guides",
    "documentation"
  ],
  "author": "Notion",
  "license": "MIT",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
  }
}
