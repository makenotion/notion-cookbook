{
  "name": "@notion-cookbook/sentry-pagerduty-incident-tools",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "tsc --project tsconfig.test.json",
    "test": "node --import tsx --test test/*.test.ts",
    "format": "prettier --write \"**/*.{md,json,ts}\"",
    "format:check": "prettier --check \"**/*.{md,json,ts}\""
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10.9.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@notionhq/workers": ">=0.0.0"
  }
}
