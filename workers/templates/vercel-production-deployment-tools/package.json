{
  "name": "@notion-cookbook/vercel-production-deployment-tools",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write README.md src/**/*.ts test/**/*.ts package.json tsconfig.json",
    "format:check": "prettier --check README.md src/**/*.ts test/**/*.ts package.json tsconfig.json"
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=10.9.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@notionhq/workers": ">=0.0.0"
  }
}
