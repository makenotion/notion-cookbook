{
  "name": "@notion-cookbook/collection-views",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.worker.json && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "dev": "npm run seed && custom-blocks-dev-shell --worker .",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:local": "node scripts/verify-local-notion.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.2"
  },
  "dependencies": {
    "@notionhq/custom-blocks": "0.2.24",
    "@notionhq/workers": "0.9.4",
    "@tanstack/react-virtual": "3.14.22",
    "@dnd-kit/react": "0.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@notionhq/custom-blocks-dev-shell": "0.1.104",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "@playwright/test": "1.63.0"
  }
}
