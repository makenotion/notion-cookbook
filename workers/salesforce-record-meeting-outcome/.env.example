# Salesforce External Client App (client credentials) and one allowlisted org.
SALESFORCE_ORG_URL=https://your-domain.my.salesforce.com
SALESFORCE_CLIENT_ID=replace-with-consumer-key
SALESFORCE_CLIENT_SECRET=replace-with-consumer-secret

# JSON map of allowed current -> target Opportunity stage transitions.
SALESFORCE_ALLOWED_STAGE_TRANSITIONS={"Discovery":["Qualification"],"Qualification":["Proposal"]}

# Comma-separated 18-character Salesforce User IDs that may own follow-up Tasks (max 25).
SALESFORCE_ALLOWED_TASK_OWNER_IDS=005000000000001AAA

# These defaults may be overridden when the org uses different labels/statuses.
NOTION_APPROVAL_PROPERTY=Meeting Outcome Status
NOTION_APPROVED_VALUE=Approved
NOTION_APPROVED_REVISION_PROPERTY=Approved Revision
NOTION_APPROVED_FINGERPRINT_PROPERTY=Approved Fingerprint
NOTION_SALESFORCE_RECEIPT_PROPERTY=Salesforce Receipt
SALESFORCE_MEETING_TASK_STATUS=Completed
SALESFORCE_FOLLOW_UP_TASK_STATUS=Not Started
