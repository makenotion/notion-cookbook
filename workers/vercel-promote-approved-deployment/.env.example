# Scope this automation token to the one configured Vercel project.
VERCEL_ACCESS_TOKEN=replace-with-a-dedicated-automation-token
VERCEL_TEAM_ID=team_example
VERCEL_PROJECT_ID=prj_example

# Fixed production surface and checks. Values must be JSON arrays.
VERCEL_PRODUCTION_DOMAINS_JSON=["app.example.com"]
VERCEL_DEPLOYMENT_CHECK_IDS_JSON=[]
VERCEL_HEALTH_PATHS_JSON=["/healthz"]

# Only approved pages in this Notion data source or database may change traffic.
NOTION_VERCEL_APPROVAL_PARENT_ID=11111111-1111-4111-8111-111111111111

# Optional: set only when deployment health requests require protection bypass.
VERCEL_PROTECTION_BYPASS_SECRET=

# Local execution only. Deployed Workers use context.notion authentication.
NOTION_API_TOKEN=replace-with-a-local-sandbox-integration-token
