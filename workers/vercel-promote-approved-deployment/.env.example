# Vercel credentials and a JSON allowlist. Keep these values server-side.
VERCEL_ACCESS_TOKEN=replace-with-a-dedicated-project-scoped-token
VERCEL_PROMOTION_TARGETS_JSON=[{"teamId":"team_example","projectId":"prj_example","productionDomains":["app.example.com"],"deploymentChecks":[{"id":"check_example","name":"Integration tests"}],"healthPaths":["/healthz"]}]

# Upstash-compatible Redis REST endpoint used for durable operation records and leases.
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-redis-rest-token

# Optional: needed only when the staged deployment has Vercel protection enabled.
VERCEL_PROTECTION_BYPASS_SECRET=

# Optional operational settings. Defaults are shown.
NOTION_PROMOTION_RECEIPT_PROPERTY=Promotion receipt
VERCEL_PROMOTION_POLL_TIMEOUT_MS=90000
VERCEL_PROMOTION_LEASE_TTL_MS=120000
VERCEL_PROMOTION_OPERATION_TTL_SECONDS=604800
VERCEL_PROMOTION_CHECK_MAX_AGE_MS=3600000

# Local sandbox only: used by `ntn workers exec --local` for context.notion.
# Never upload this value with `ntn workers env set`; revoke it after testing.
NOTION_API_TOKEN=replace-with-a-sandbox-internal-integration-token
