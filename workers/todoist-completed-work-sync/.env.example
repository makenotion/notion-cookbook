# Copy this file to `.env` and fill in your own values for local testing.
# `.env` is gitignored. Never commit real credentials.
# For a deployed Worker, set these with `ntn workers env set KEY=value`.

# Required: immutable ID returned as `id` by Todoist's GET /api/v1/user.
# Every capability checks this value before reading task or project data.
TODOIST_USER_ID=

# Required: personal API token from Todoist Settings > Integrations > Developer.
TODOIST_API_TOKEN=

# Optional: earliest completion date or timestamp to import when a sync has no
# checkpoint. Accepts YYYY-MM-DD or an ISO 8601 timestamp with a time zone.
# Defaults to 365 days before the first run.
TODOIST_HISTORY_START=
