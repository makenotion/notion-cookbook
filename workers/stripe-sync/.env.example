# Copy this file to `.env` and fill in your own values for local testing.
# `.env` is gitignored — never commit real credentials.
# For a deployed worker, set this with `ntn workers env set KEY=value` instead.

# Required: Stripe secret key from Developers > API keys. Use a restricted key
# with read-only access to Customers, Subscriptions, and Charges if possible.
STRIPE_API_KEY=
