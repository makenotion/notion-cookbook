# Intercom private-app identity and bounded routing target.
INTERCOM_ACCESS_TOKEN=replace-with-a-private-app-access-token
INTERCOM_REGION=us
INTERCOM_WORKSPACE_ID=replace-with-the-app-id-code-returned-by-get-me
INTERCOM_ADMIN_ID=replace-with-the-admin-id-returned-by-get-me

# Jira Cloud automation identity. Use a dedicated account limited to the projects below.
JIRA_DOMAIN=example
JIRA_EMAIL=automation@example.com
JIRA_API_TOKEN=replace-with-an-atlassian-api-token
JIRA_ACTING_ACCOUNT_ID=replace-with-the-account-id-returned-by-get-myself

# Each approved Jira project and issue type has exactly one Intercom team/tag route.
ESCALATION_TARGETS_JSON=[{"jiraProjectKey":"ENG","jiraIssueTypeIds":["10001"],"intercomTeamId":"12345","intercomTagId":"67890"}]

# Upstash-compatible Redis REST database used for permanent source mappings,
# durable operation records, compare-and-set updates, and source leases.
UPSTASH_REDIS_REST_URL=https://replace-with-your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-redis-rest-token

# Optional names and operational bounds. Defaults are shown.
NOTION_ESCALATION_STATUS_PROPERTY=Escalation status
NOTION_ESCALATION_APPROVED_VALUE=Approved
NOTION_ESCALATION_REVISION_PROPERTY=Escalation revision
NOTION_ESCALATION_FINGERPRINT_PROPERTY=Escalation fingerprint
NOTION_ESCALATION_PACKET_PROPERTY=Escalation packet
NOTION_ESCALATION_RECEIPT_PROPERTY=Escalation receipt
ESCALATION_REQUEST_TIMEOUT_MS=8000
ESCALATION_LEASE_TTL_MS=120000
ESCALATION_OPERATION_TTL_SECONDS=2592000

# Local sandbox only: used by `ntn workers exec --local` for context.notion.
# Never upload this value with `ntn workers env set`; revoke it after testing.
NOTION_API_TOKEN=replace-with-a-sandbox-internal-integration-token
