# Intercom private-app identity and bounded routing target.
INTERCOM_ACCESS_TOKEN=replace-with-a-private-app-access-token
INTERCOM_REGION=us
INTERCOM_WORKSPACE_ID=replace-with-the-app-id-code-returned-by-get-me
INTERCOM_ADMIN_ID=replace-with-the-admin-id-returned-by-get-me
INTERCOM_TEAM_ID=replace-with-the-fixed-escalation-team-id
INTERCOM_TAG_ID=replace-with-the-fixed-escalation-tag-id

# Fixed Notion destination shared with the Custom Agent.
NOTION_TICKETS_DATA_SOURCE_ID=replace-with-the-ticket-data-source-id

# Optional request bound. The default is shown.
ESCALATION_REQUEST_TIMEOUT_MS=8000

# Local sandbox only: used by `ntn workers exec --local` for context.notion.
# Never upload this value with `ntn workers env set`; revoke it after testing.
NOTION_API_TOKEN=replace-with-a-sandbox-internal-integration-token
