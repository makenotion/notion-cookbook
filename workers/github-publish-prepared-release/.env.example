# Copy to .env for local/sandbox testing. Never commit real values.

# Exact allowlist. Bind each mutable owner/name to GitHub's immutable repository
# ID; the tool rejects a renamed/mismatched repository before any other read.
GITHUB_ALLOWED_REPOSITORIES_JSON=[{"repository":"example-org/release-sandbox","repositoryId":123456789}]

# Recommended: one GitHub App installation limited to the repositories above.
# Repository permissions: Contents write, Checks read, Metadata read.
GITHUB_AUTH_MODE=installation
GITHUB_APP_CLIENT_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=

# Fallback: a fine-grained PAT limited to the repositories and permissions above.
# Set GITHUB_AUTH_MODE=pat before using this value.
GITHUB_TOKEN=

# Durable operation ledger and lease (Upstash-compatible Redis REST endpoint).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Property names on the approved Notion release-packet database page.
NOTION_APPROVAL_STATUS_PROPERTY=Approval status
NOTION_APPROVED_STATUS=Approved
NOTION_APPROVAL_REVISION_PROPERTY=Approval revision
NOTION_APPROVAL_FINGERPRINT_PROPERTY=Approval fingerprint
NOTION_RELEASE_RECEIPT_PROPERTY=Release receipt

# Local `ntn workers exec --local` only. Use a sandbox Notion integration token
# with access to the test packet; do not configure or deploy this extra secret
# for invocation-scoped Custom Agent calls.
NOTION_API_TOKEN=
